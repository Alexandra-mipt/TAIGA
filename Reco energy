def filter_data(df):
    common_filters = (
        (df['size'] > 120) &
        (df['width[0]'] > 0.024) &
        (df['width[0]'] < 0.068 * np.log10(df['size']) - 0.047) &
        (df['length[0]'] < 0.145 * np.log10(df['size']))
    )
    
    source_df = df[
        common_filters &
        (df['dist[1]'].between(0.36, 1.3))
    ]
    return source_df

